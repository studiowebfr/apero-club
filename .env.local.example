# Copie ce fichier en `.env.local` (jamais commité) et remplis les valeurs.

# Identifiant du formulaire Formspree (https://formspree.io), pour l'envoi
# du formulaire de contact. Sans lui, le formulaire affiche un message
# clair au lieu d'échouer en silence. Format : juste l'identifiant, pas
# l'URL complète (ex: "xrgwkyzp").
NEXT_PUBLIC_FORMSPREE_ID=

# URL de production du site (GitHub Pages, ou un nom de domaine perso une
# fois branché). Sert au sitemap, au JSON-LD et aux images Open Graph.
NEXT_PUBLIC_SITE_URL=https://studiowebfr.github.io/apero-club
